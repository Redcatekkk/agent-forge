{
  "name": "{{report.repo_name}}",
  "version": "0.1.0",
  "description": "Generated by Agent-Forge from {{report.source}} analysis.",
  "mcpServers": {
    "{{report.repo_name}}": {
      "command": "agent-forge",
      "args": ["serve", "{{report.target_dir}}"]
    }
  },
  "tools": [
    {{#each tools}}
    {
      "name": "{{name}}",
      "description": "{{description}}",
      "metadata": {
        "framework": "{{framework}}",
        "method": {{#if method}}"{{method}}"{{else}}null{{/if}},
        "route": {{#if route}}"{{route}}"{{else}}null{{/if}},
        "file": "{{file}}"
      },
      "inputSchema": {{{input_schema_json}}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ]
}
